# API Configuration
# Base URL for the backend API
NEXT_PUBLIC_API_BASE_URL=https://staging-api.icadpay.com

# OAuth Client Credentials
# These are required for authentication
# Replace these with your actual client credentials from the backend team
NEXT_PUBLIC_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_CLIENT_SECRET=your_client_secret_here

# OAuth Grant Type (defaults to "password" if not set)
NEXT_PUBLIC_GRANT_TYPE=password
